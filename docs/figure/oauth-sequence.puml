@startuml
' Locuvera — Google OAuth 2.0 (Authorization Code) 흐름
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "AppleSDGothicNeo"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 24
skinparam BoxPadding 12

skinparam participant {
  BorderColor #111111
  BackgroundColor #F4F4F5
  FontColor #111111
}
skinparam sequence {
  ArrowColor #111111
  ArrowFontColor #111111
  LifeLineBorderColor #9CA3AF
  LifeLineBackgroundColor #E5E7EB
  GroupBorderColor #111111
  GroupBackgroundColor #F4F4F5
  GroupHeaderFontColor #111111
  DividerBackgroundColor #111111
  DividerFontColor #FFFFFF
  ReferenceBackgroundColor #F4F4F5
}
skinparam note {
  BorderColor #111111
  BackgroundColor #FAFAFA
  FontColor #333333
}

participant "사용자\n브라우저" as B
participant "프론트엔드\n(SPA)" as F
participant "백엔드\n(FastAPI)" as S
participant "Google\n서버" as G

autonumber "<b>0."

== 인증 시작 ==
B -> S : "Google로 계속하기"\nGET /auth/google/start?mode=login|signup
activate S
note over S #FAFAFA : sign_state(mode)\nHMAC 서명 state 생성 (만료 10분, 서버 저장 X)
S --> B : 302 Redirect → Google 인증 URL\n(client_id, scope=openid email profile, state)
deactivate S

B -> G : 로그인 · 계정 선택 · 동의
activate G
G --> B : 302 Redirect → redirect_uri\n(code, state)
deactivate G
B -> S : GET /auth/google/callback?code&state
activate S

== 토큰 교환 (서버 ↔ Google) ==
note over S #FAFAFA : verify_state(state)\nHMAC · 만료 검증 (CSRF 방지)
S -> G : POST /token\n(code + client_id/secret + redirect_uri)
activate G
G --> S : access_token
S -> G : GET /userinfo (Bearer access_token)
G --> S : { sub, email, email_verified, name }
deactivate G

== 계정 매칭 ==
note over S #FAFAFA : ① user_oauth_identities 에서 Google sub 조회\n② 없으면 email_verified=TRUE 인 동일 이메일 계정에 자동 연동

alt 기존(연동/매칭) 계정 있음
  note over S #FAFAFA : oauth_handoff 코드 발급 (일회성, 2분)\n세션 토큰은 URL에 직접 싣지 않음
  S --> B : 302 → /auth/callback#code=<handoff>
  deactivate S
  B -> F : /auth/callback 로드
  activate F
  F -> S : POST /auth/session/exchange { code }
  activate S
  note over S #FAFAFA : consume(handoff) → _issue_session_for_user
  S --> F : { 세션 토큰, user }
  deactivate S
  F -> F : 세션 저장 → role 별 이동\n(admin → /verification, staff → /equipment)
  deactivate F

else 매칭되는 계정 없음 → 신규 가입
  note over S #FAFAFA : oauth_pending 토큰 발급 (30분)\npayload: provider, sub, email, name
  S --> B : 302 → /signup/complete#pending&email&name
  activate S
  deactivate S
  B -> F : /signup/complete 로드
  activate F
  note over F #FAFAFA : 추가 정보 입력\n아이디 · 이름 · 권한 · 부서/직책 · 비밀번호(필수)
  F -> S : POST /auth/google/complete\n{ pending_token, 입력값 }
  activate S
  note over S #FAFAFA : consume(pending)\nusers INSERT (email_verified=TRUE, 인증메일 없음)\nuser_oauth_identities INSERT (sub 연동)
  S --> F : { 세션 토큰, user }
  deactivate S
  F -> F : 자동 로그인 → role 별 이동
  deactivate F
end

@enduml
